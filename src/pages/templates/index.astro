---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResourceListing from '../../components/ResourceListing.astro';
import { getPublished } from '../../lib/content';
import { categoryOptions, templateCard, templateCategoryPath } from '../../lib/cards';
import { TEMPLATE_CATEGORIES, TEMPLATE_CATEGORY_LABELS } from '../../lib/taxonomy';

const templates = await getPublished('templates');
const options = categoryOptions(
  templates,
  TEMPLATE_CATEGORIES,
  TEMPLATE_CATEGORY_LABELS,
  templateCategoryPath,
);

const title = 'Template Library';
const description =
  'Free, editable design templates for Jain festival posters, invitations, social posts and WhatsApp status, with clear licence details.';
---

<BaseLayout {title} {description}>
  <PageHeader
    {title}
    eyebrow="Explore"
    intro="Editable posters, invitations and social posts. Download a template, replace the text in [brackets] with your own, and share."
    breadcrumbs={[{ label: title }]}
  />
  <ResourceListing
    label="Templates"
    cards={templates.map(templateCard)}
    filter={{ allHref: '/templates', allCount: templates.length, options }}
    emptyTitle="No templates yet"
    emptyMessage="We are preparing our first templates. Please check back soon."
    emptyAction={{ href: '/', label: 'Back to home' }}
  />
</BaseLayout>
