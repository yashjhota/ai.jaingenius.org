---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResourceListing from '../../components/ResourceListing.astro';
import { getPublished } from '../../lib/content';
import { countByCategory } from '../../lib/resources';
import { promptCard, promptCategoryPath } from '../../lib/cards';
import { PROMPT_CATEGORIES, PROMPT_CATEGORY_LABELS } from '../../lib/taxonomy';

const prompts = await getPublished('prompts');
const options = countByCategory(prompts, PROMPT_CATEGORIES).map(({ category, count }) => ({
  href: promptCategoryPath(category),
  label: PROMPT_CATEGORY_LABELS[category],
  count,
}));

const title = 'Prompt Library';
const description =
  'Ready-to-copy AI prompts for Jain festivals, greetings, invitations, social media and education. Copy a prompt and use it in your favourite AI tool.';
---

<BaseLayout title={title} {description}>
  <PageHeader
    {title}
    eyebrow="Explore"
    intro="Ready-to-copy prompts for Jain festivals, events, social media and education. Open a prompt, press Copy, and paste it into the AI tool you use."
    breadcrumbs={[{ label: title }]}
  />
  <ResourceListing
    label="Prompts"
    cards={prompts.map(promptCard)}
    filter={{ allHref: '/prompts', allCount: prompts.length, options }}
    emptyTitle="No prompts yet"
    emptyMessage="We are preparing our first prompts. Please check back soon."
    emptyAction={{ href: '/', label: 'Back to home' }}
  />
</BaseLayout>
