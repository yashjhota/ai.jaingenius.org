---
/**
 * Breadcrumb trail with matching BreadcrumbList structured data.
 * "Home" is added automatically. The last item is the current page.
 */
import { SITE } from '../lib/site';

export interface Crumb {
  label: string;
  href?: string;
}

export interface Props {
  items: readonly Crumb[];
}

const crumbs: Crumb[] = [{ label: 'Home', href: '/' }, ...Astro.props.items];
const base = Astro.site ?? SITE.url;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    item: new URL(crumb.href ?? Astro.url.pathname, base).href,
  })),
};
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((crumb, i) =>
      i === crumbs.length - 1 ? (
        <li aria-current="page">{crumb.label}</li>
      ) : (
        <li>
          <a href={crumb.href}>{crumb.label}</a>
        </li>
      ),
    )}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<style>
  .breadcrumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .breadcrumbs li + li::before {
    content: '/';
    margin-right: var(--space-1);
    color: var(--text-subtle);
  }
  .breadcrumbs [aria-current='page'] {
    color: var(--text);
    font-weight: 600;
  }
</style>
