---
/** Plain list of tags. Not linked: there are no tag pages (search covers tags). */
export interface Props {
  tags: readonly string[];
  label?: string;
}

const { tags, label = 'Tags' } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tags" aria-label={label}>
    {tags.map((tag) => (
      <li>#{tag}</li>
    ))}
  </ul>
)}

<style>
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
