  "private": true,
  "description": "Jain AI — by Jain Genius. Digital creativity and AI resource hub for the Jain community.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
